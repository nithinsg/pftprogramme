# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and adjust per environment. VITE_* vars are PUBLIC —
# they are inlined into the client bundle. Never put secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# Absolute origin the site is served from. Used for canonical URLs, the
# sitemap and the Open Graph / WhatsApp preview image URL (must be absolute).
# It MUST match the origin actually serving the site, or the WhatsApp preview
# will point at an image that does not exist.
VITE_SITE_URL=https://pulmo-mentor-pft.vercel.app

# Search-engine policy. Keep this at "noindex" for every staging or review
# deployment: this site carries a real hospital's name alongside placeholder
# content, and it must not be crawled and indexed as the hospital's own site.
# Set it to "index" only at go-live, on the final domain, with approved content.
VITE_ROBOTS=noindex

# Show the dashed "CONTENT PENDING APPROVAL" markers on placeholder content.
# Set to "false" before a client demo or before go-live.
VITE_SHOW_PLACEHOLDERS=true

# Analytics measurement ID (GA4). Leave blank to disable the loader; events
# are still queued to window.dataLayer so any tag manager can pick them up.
VITE_GA_MEASUREMENT_ID=

# Log every analytics event to the console (development aid).
VITE_ANALYTICS_DEBUG=false
